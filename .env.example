# Google Gemini API key, used client-side by src/utils/geminiService.ts (in-app
# financing chatbot) and src/utils/geminiMaps.ts (grounded dealer search).
# Optional: the app degrades gracefully (chat disabled, warning logged) if unset.
# Get a key at https://aistudio.google.com/app/apikey
#
# WARNING: this is a Vite VITE_* variable, so it is inlined into the built
# JS bundle at build time and is publicly visible to anyone who loads the app
# (see README "Known limitations"). Do not use a key with billing you can't
# afford to have scraped/abused.
VITE_GEMINI_API_KEY=

# Optional override for the Gemini model used for grounded dealer search
# (src/utils/geminiMaps.ts). Falls back to gemini-2.5-flash, then
# gemini-2.5-pro, if unset.
VITE_GEMINI_MODEL=
